{
  "name": "tracey",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.7.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "pnpm -r build",
    "dev": "pnpm --filter @tracey/api dev",
    "start": "pnpm --filter @tracey/api start",
    "tracey:up": "node scripts/tracey-runtime.mjs up",
    "tracey:status": "node scripts/tracey-runtime.mjs status",
    "tracey:down": "node scripts/tracey-runtime.mjs down",
    "test:runtime": "node --test scripts/tracey-runtime.test.mjs",
    "mcp:stdio": "pnpm --filter @tracey/mcp-stdio start",
    "test": "pnpm -r test",
    "typecheck": "pnpm -r typecheck",
    "lint": "pnpm -r lint",
    "verify:live": "node scripts/verify-live.mjs",
    "verify:mcp": "node scripts/verify-mcp.mjs",
    "verify:cohort": "node scripts/verify-cohort.mjs",
    "verify:codex": "node scripts/verify-codex.mjs",
    "verify:frontend": "node scripts/verify-frontend-e2e.mjs",
    "verify:agent-onboarding": "node scripts/verify-agent-onboarding.mjs",
    "verify:runs-load": "pnpm --filter @tracey/api build && node scripts/load-test-runs.mjs",
    "verify:clean-install": "node scripts/verify-clean-install.mjs",
    "verify:tenant-isolation": "pnpm --filter @tracey/signoz-adapter build && node scripts/verify-tenant-isolation.mjs",
    "verify:oidc": "node scripts/verify-oidc.mjs",
    "verify:oidc:keycloak": "pnpm --filter @tracey/api build && node scripts/verify-oidc-keycloak.mjs",
    "verify:durable-jobs": "pnpm --dir apps/worker exec node --conditions=development --import tsx ../../scripts/verify-durable-jobs.ts",
    "verify:website-security": "pnpm --dir apps/worker exec node --conditions=development --import tsx ../../scripts/verify-website-security.ts",
    "backup:postgres": "node scripts/postgres-backup.mjs",
    "restore:postgres": "node scripts/postgres-restore.mjs",
    "verify:backup-restore": "node scripts/verify-backup-restore.mjs",
    "verify:production": "node scripts/verify-production-deployment.mjs",
    "verify:production:kind": "node scripts/verify-production-kind.mjs",
    "eval:capture": "node scripts/capture-evaluation.mjs",
    "eval:report": "pnpm --filter @tracey/evaluation build && node scripts/evaluate-dataset.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.1.2",
    "dotenv": "^17.2.1",
    "eslint": "^10.8.0",
    "pg": "8.22.0",
    "typescript": "^7.0.2",
    "typescript-eslint": "^8.65.0",
    "yaml": "2.9.0"
  }
}
