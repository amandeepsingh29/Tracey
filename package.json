{
  "name": "tracey",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.7.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "pnpm -r build",
    "dev": "pnpm --filter @tracey/api dev",
    "start": "pnpm --filter @tracey/api start",
    "mcp:stdio": "pnpm --filter @tracey/mcp-stdio start",
    "test": "pnpm -r test",
    "typecheck": "pnpm -r typecheck",
    "lint": "pnpm -r lint",
    "verify:live": "node scripts/verify-live.mjs",
    "verify:mcp": "node scripts/verify-mcp.mjs",
    "verify:cohort": "node scripts/verify-cohort.mjs",
    "verify:codex": "node scripts/verify-codex.mjs",
    "verify:frontend": "node scripts/verify-frontend-e2e.mjs",
    "eval:capture": "node scripts/capture-evaluation.mjs",
    "eval:report": "pnpm --filter @tracey/evaluation build && node scripts/evaluate-dataset.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.1.1",
    "dotenv": "^17.2.1",
    "eslint": "^10.8.0",
    "typescript": "^7.0.2",
    "typescript-eslint": "^8.65.0"
  }
}
