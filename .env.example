# Application
PORT=3000
LOG_LEVEL=info
DEPLOYMENT_ENVIRONMENT=development
TRACEY_TENANT_ID=local
# Required for every /v1/* endpoint. Keep this distinct from provider and MCP credentials.
TRACEY_API_BEARER_TOKEN=
TRACEY_UI_ACCESS_TOKEN=
# Optional neutral defaults shown by the UI; these do not grant connector access.
TRACEY_UI_DEFAULT_NAMESPACE=
TRACEY_UI_DEFAULT_WORKLOAD=
TRACEY_UI_DEFAULT_SERVICE=
# Non-secret identifier used in bounded access-audit telemetry.
TRACEY_API_TOKEN_ID=primary
# Isolates repository-owned Compose projects and allows parallel clean-install verification.
TRACEY_RUNTIME_ID=tracey
TRACEY_WEB_PORT=8501
# Optional production OIDC. Tokens must contain the configured tenant and role claims.
OIDC_ISSUER_URL=
OIDC_JWKS_URL=
OIDC_AUDIENCE=
OIDC_TENANT_CLAIM=tenant_id
OIDC_ROLES_CLAIM=roles
# Web authorization-code + PKCE login. Production and staging deployments use
# OIDC mode; local mode may keep the loopback-only shared API token workflow.
TRACEY_WEB_AUTH_MODE=local
TRACEY_WEB_OIDC_CLIENT_ID=
TRACEY_WEB_OIDC_CLIENT_SECRET=
TRACEY_WEB_OIDC_SCOPES=openid profile email offline_access
TRACEY_WEB_SESSION_SECRET=
TRACEY_WEB_PUBLIC_URL=http://127.0.0.1:8501
# Short-lived token used only by `pnpm verify:oidc`; never store it in source control.
TRACEY_OIDC_TEST_TOKEN=
TRACEY_KEYCLOAK_IMAGE=quay.io/keycloak/keycloak:26.7.0
TRACEY_AGENT_VERSION=0.1.0

# Application -> local OpenTelemetry Collector (OTLP/HTTP).
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318

# Tracey -> SigNoz query API, for example https://your-instance.signoz.cloud.
SIGNOZ_API_URL=
SIGNOZ_API_KEY=
SIGNOZ_QUERY_TIMEOUT_MS=5000
SIGNOZ_COHORT_TIMEOUT_MS=25000

# Tracey control-plane metadata and pgvector semantic indexes. Raw telemetry remains in SigNoz.
DATABASE_URL=
# Optional local-only password for the non-superuser role created by tracey:up.
# It defaults to the DATABASE_URL password when omitted.
TRACEY_POSTGRES_APP_PASSWORD=
POSTGRES_POOL_MAX=10
POSTGRES_IDLE_TIMEOUT_MS=30000
POSTGRES_STATEMENT_TIMEOUT_MS=5000

# Optional agentic investigation layer. Deterministic analysis remains authoritative.
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
TRACEY_AGENT_MODEL=tencent/hy3:free
TRACEY_AGENT_TIMEOUT_MS=60000
TRACEY_AGENT_TOOL_TIMEOUT_MS=30000

# Optional approved action executor. Notifications are stored inside Tracey at /notifs.
TRACEY_ACTION_WEBHOOK_URL=
TRACEY_ACTION_WEBHOOK_TOKEN=
# Restricted typed executor service used for Kubernetes mutations.
TRACEY_EXECUTOR_URL=
TRACEY_EXECUTOR_BEARER_TOKEN=
# Native Kubernetes execution is fail-closed. Enable it only for a dedicated
# restricted executor deployment, never for the read-only investigator API pod.
TRACEY_KUBERNETES_EXECUTOR_ENABLED=false
TRACEY_KUBERNETES_INVESTIGATOR_ENABLED=false
# Comma-separated Kubernetes names, or * for every namespace/workload visible to the Tracey ServiceAccount.
TRACEY_KUBERNETES_ALLOWED_NAMESPACES=
TRACEY_KUBERNETES_ALLOWED_WORKLOADS=
TRACEY_KUBERNETES_ALLOW_CLUSTER_SCOPED_MUTATIONS=false

# Durable PostgreSQL-backed trigger and action worker.
TRACEY_API_URL=http://api:3000
JOB_POLL_INTERVAL_MS=2000
WORKER_JOB_CONCURRENCY=4
WORKER_JOB_LEASE_SECONDS=300
WORKER_HEALTH_PORT=3001

# Optional real MCP Streamable HTTP server. Only comma-separated tools in the
# explicit read allowlist can be called through Tracey.
MCP_SERVER_URL=
MCP_SERVER_NAME=configured-mcp
MCP_BEARER_TOKEN=
MCP_ALLOWED_READ_TOOLS=
MCP_CONNECT_TIMEOUT_MS=10000
MCP_TOOL_TIMEOUT_MS=15000

# Tracey read-only MCP server at /mcp. It is enabled only when SigNoz query
# credentials and this independent bearer token are configured.
TRACEY_MCP_BEARER_TOKEN=
TRACEY_MCP_ALLOWED_HOSTS=localhost,127.0.0.1

# Local Codex developer-forensics connector. In development the mode defaults
# to enabled and the sessions directory defaults to ~/.codex/sessions.
# It joins full local prompt/tool history to SigNoz metadata without exporting
# that content back to SigNoz or the Tracey investigation model.
TRACEY_LOCAL_FORENSIC_MODE=true
TRACEY_CODEX_SESSIONS_DIR=

# Collector -> SigNoZ Cloud. Self-hosted users should use the self-hosted config.
SIGNOZ_OTLP_ENDPOINT=
SIGNOZ_INGESTION_KEY=
