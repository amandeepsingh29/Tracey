FROM node:22-alpine AS build
WORKDIR /workspace
RUN corepack enable
COPY . .
RUN pnpm install --frozen-lockfile
RUN pnpm --filter @tracey/web build

FROM node:22-alpine AS runtime
ENV NODE_ENV=production PORT=8501 HOSTNAME=0.0.0.0 HOME=/tmp
WORKDIR /app
RUN addgroup -g 10001 tracey && adduser -D -u 10001 -G tracey tracey
COPY --from=build --chown=tracey:tracey /workspace/apps/web/.next/standalone ./
COPY --from=build --chown=tracey:tracey /workspace/apps/web/.next/static ./apps/web/.next/static
USER tracey
EXPOSE 8501
CMD ["node", "apps/web/server.js"]
